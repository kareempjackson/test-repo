generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RENTER
  OWNER
  BOTH
  ADMIN
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  phone        String?
  role         UserRole  @default(RENTER)
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  vehicles     Vehicle[]
  bookings     Booking[] @relation("RenterBookings")
  messages     Message[]

  @@map("users")
}

model Vehicle {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  make        String
  model       String
  year        Int
  licensePlate String       @map("license_plate")
  color       String?
  description String?
  dailyRate   Decimal       @map("daily_rate") @db.Decimal(10, 2)
  location    String
  island      String
  status      VehicleStatus @default(ACTIVE)
  imageUrls   String[]      @map("image_urls")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([ownerId])
  @@index([island])
  @@index([status])
  @@map("vehicles")
}

model Booking {
  id          String        @id @default(uuid())
  vehicleId   String        @map("vehicle_id")
  renterId    String        @map("renter_id")
  startDate   DateTime      @map("start_date")
  endDate     DateTime      @map("end_date")
  totalPrice  Decimal       @map("total_price") @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  renter      User          @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([vehicleId])
  @@index([renterId])
  @@index([status])
  @@map("bookings")
}

model Message {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  senderId  String   @map("sender_id")
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([isRead])
  @@map("messages")
}
