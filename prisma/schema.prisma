generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RENTER
  OWNER
  BOTH
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReviewType {
  CAR_REVIEW
  RENTER_REVIEW
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  phone              String?
  role               UserRole  @default(RENTER)
  isVerified         Boolean   @default(false) @map("is_verified")
  renterRating       Float?    @default(0) @map("renter_rating")
  totalRenterReviews Int?      @default(0) @map("total_renter_reviews")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vehicles         Vehicle[]
  bookings         Booking[]       @relation("RenterBookings")
  reviewsWritten   Review[]        @relation("ReviewerReviews")
  reviewsReceived  Review[]        @relation("RevieweeReviews")

  @@map("users")
}

model Vehicle {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  make          String
  model         String
  year          Int
  color         String?
  licensePlate  String   @map("license_plate")
  vin           String?  @unique
  description   String?
  dailyRate     Float    @map("daily_rate")
  location      String
  latitude      Float?
  longitude     Float?
  isAvailable   Boolean  @default(true) @map("is_available")
  images        String[]
  features      String[]
  averageRating Float?   @default(0) @map("average_rating")
  totalReviews  Int?     @default(0) @map("total_reviews")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerId], references: [id])
  bookings Booking[]
  reviews  Review[]

  @@map("vehicles")
}

model Booking {
  id          String        @id @default(uuid())
  vehicleId   String        @map("vehicle_id")
  renterId    String        @map("renter_id")
  startDate   DateTime      @map("start_date")
  endDate     DateTime      @map("end_date")
  totalPrice  Float         @map("total_price")
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  renter  User     @relation("RenterBookings", fields: [renterId], references: [id])
  reviews Review[]

  @@map("bookings")
}

model Review {
  id         String     @id @default(uuid())
  bookingId  String     @map("booking_id")
  reviewerId String     @map("reviewer_id")
  revieweeId String?    @map("reviewee_id")
  vehicleId  String?    @map("vehicle_id")
  reviewType ReviewType @map("review_type")
  rating     Int
  comment    String
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  booking  Booking  @relation(fields: [bookingId], references: [id])
  reviewer User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewee User?    @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])

  @@unique([bookingId, reviewType])
  @@index([bookingId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([vehicleId])
  @@map("reviews")
}
