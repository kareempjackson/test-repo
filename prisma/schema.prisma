// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  RENTER
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ReviewType {
  CAR
  RENTER
}

enum DocumentType {
  DRIVERS_LICENSE
  PASSPORT
  NATIONAL_ID
  PROOF_OF_ADDRESS
  VEHICLE_REGISTRATION
  INSURANCE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String             @map("password_hash")
  phone              String?
  role               UserRole           @default(RENTER)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  vehicles              Vehicle[]
  bookingsAsRenter      Booking[]              @relation("RenterBookings")
  messagesSent          Message[]
  reviewsWritten        Review[]               @relation("ReviewerReviews")
  reviewsReceived       Review[]               @relation("RevieweeReviews")
  verificationDocuments VerificationDocument[] @relation("UserDocuments")
  documentsReviewed     VerificationDocument[] @relation("ReviewerDocuments")

  @@index([email])
  @@index([role])
  @@index([verificationStatus])
  @@map("users")
}

model Vehicle {
  id             String           @id @default(cuid())
  ownerId        String           @map("owner_id")
  make           String
  model          String
  year           Int
  description    String?
  dailyRateCents Int              @map("daily_rate_cents")
  locationText   String           @map("location_text")
  locationLat    Float?           @map("location_lat")
  locationLng    Float?           @map("location_lng")
  seats          Int              @default(5)
  transmission   TransmissionType @default(AUTOMATIC)
  fuelType       FuelType         @default(GASOLINE) @map("fuel_type")
  status         VehicleStatus    @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images       VehicleImage[]
  availability Availability[]
  bookings     Booking[]

  @@index([ownerId])
  @@index([status])
  @@index([make, model])
  @@index([locationLat, locationLng])
  @@index([dailyRateCents])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String   @map("vehicle_id")
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, position])
  @@map("vehicle_images")
}

model Availability {
  id          String   @id @default(cuid())
  vehicleId   String   @map("vehicle_id")
  date        DateTime @db.Date
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, date])
  @@index([vehicleId])
  @@index([date])
  @@index([vehicleId, date, isAvailable])
  @@map("availability")
}

model Booking {
  id                    String        @id @default(cuid())
  vehicleId             String        @map("vehicle_id")
  renterId              String        @map("renter_id")
  startDate             DateTime      @map("start_date") @db.Date
  endDate               DateTime      @map("end_date") @db.Date
  totalCents            Int           @map("total_cents")
  platformFeeCents      Int           @map("platform_fee_cents")
  status                BookingStatus @default(PENDING)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relations
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  renter   User      @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  messages Message[]
  reviews  Review[]

  @@index([vehicleId])
  @@index([renterId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([vehicleId, startDate, endDate])
  @@index([stripePaymentIntentId])
  @@map("bookings")
}

model Message {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  senderId  String   @map("sender_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([senderId])
  @@index([bookingId, createdAt])
  @@map("messages")
}

model Review {
  id         String     @id @default(cuid())
  bookingId  String     @map("booking_id")
  reviewerId String     @map("reviewer_id")
  revieweeId String     @map("reviewee_id")
  rating     Int
  comment    String?
  type       ReviewType
  createdAt  DateTime   @default(now()) @map("created_at")

  // Relations
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([bookingId, reviewerId, type])
  @@index([bookingId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([type])
  @@index([revieweeId, type])
  @@map("reviews")
}

model VerificationDocument {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  documentType DocumentType   @map("document_type")
  fileUrl      String         @map("file_url")
  status       DocumentStatus @default(PENDING)
  reviewedAt   DateTime?      @map("reviewed_at")
  reviewedBy   String?        @map("reviewed_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  user     User  @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewerDocuments", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([userId, documentType])
  @@index([reviewedBy])
  @@map("verification_documents")
}
