# Database
DATABASE_URL="postgresql://user:password@localhost:5432/caribbean_wheels?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# AWS S3 (optional - if not set, mock URLs will be used)
